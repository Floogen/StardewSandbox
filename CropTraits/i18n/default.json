  "trait.luminous.details": "Glows softly at night",
  "trait.luminous.notes": "Only the planted crop glows, not its produce.",
  "trait.tinted.name": "Tinted",
  "trait.tinted.description": "Unusually colored.",
  "trait.tinted.details": "The crop and its produce are tinted",
  "trait.tinted.notes": "Each crop type has its own tint, so its produce still stacks. Flowers keep their own petal colors, both on the crop and as produce.",
  "trait.colossal.name": "Colossal",
  "trait.colossal.description": "More likely to become a giant crop.",
  "trait.colossal.details": "+{{giantCropChance}}% chance each night to become a giant crop",
  "trait.colossal.notes": "Vanilla giant crops have a 1% chance. Only one crop in the grid needs Colossal (the highest tier counts).",
  "trait.resilient.name": "Resilient",
  "trait.resilient.description": "Diluting it removes one trait instead of risking them all.",
  "trait.resilient.details": "Diluting it in the Seed Splicer always splits off one trait instead of sometimes wiping them all",
  "trait.resilient.notes": "The trait removed is still picked evenly, so Resilient itself can be the one removed. A crop with only one trait reverts to the baseline.",
  "trait.prismatic.name": "Prismatic",
  "trait.prismatic.description": "Shimmers with every color.",
  "trait.prismatic.details": "Cycles through rainbow colors, glows at night and sells for {{priceBonus}}% more",
  "trait.prismatic.notes": "Flowers keep their own petal colors. Its price bonus carries into artisan goods made from it.",
  "trait.titanic.name": "Titanic",
  "trait.titanic.description": "Giant crops drop more produce.",
  "trait.titanic.details": "+{{giantCropChance}}% chance each night to become a giant crop, which drops {{yieldBonus}}% more produce",
  "trait.titanic.notes": "A giant crop keeps up to three traits from the crops it formed from, so the extra produce needs Titanic to be one of them. Only the produce dropped when it breaks is boosted, not pieces knocked off with the Shaving enchantment.",
  "trait.heirloom.name": "Heirloom",
  "trait.heirloom.description": "Passes all its traits down when crossbred.",
  "trait.heirloom.details": "Its traits always carry over when crossbred. Mutations can't replace them either",
  "trait.heirloom.notes": "The three trait limit and conflicts still apply when crossbreeding.",
  "trait.bittersweet.name": "Bittersweet",
  "trait.bittersweet.description": "Its price changes every day.",
  "trait.bittersweet.details": "Each day, sells for either {{highPriceBonus}}% more or {{lowPricePenalty}}% less",
  "trait.bittersweet.notes": "Every Bittersweet item has the same price on a given day. The change also carries into artisan goods.",
  "trait.coarse.name": "Coarse",
  "trait.coarse.description": "Chance for lower quality produce.",
  "trait.coarse.details": "{{stepDownChance}}% chance for the harvest to drop one quality step",
  "trait.coarse.notes": "Steps go normal, silver, gold then iridium. Quality never goes below normal or past the crop's own limits.",
  "trait.musty.name": "Musty",
  "trait.musty.description": "Artisan goods made from it sell for less.",
  "trait.musty.details": "Artisan goods made from it sell for {{artisanPricePenalty}}% less",
  "trait.musty.notes": "The produce itself sells at its normal price. Only appears on fruit and vegetables.",
  "trait.nurturing.name": "Nurturing",
  "trait.nurturing.description": "Speeds up the growth of nearby crops.",
  "trait.nurturing.details": "Each adjacent crop of another type has a {{boostChance}}% chance to grow an extra day each night",
  "trait.nurturing.notes": "Covers all eight adjacent tiles. A crop can only gain one extra day a night this way, regardless of how many Nurturing crops surround it. The extra day only counts on nights the neighbor grows (when it's watered). Crops with Balanced aren't affected.",
  "trait.sunloving.name": "Sun Loving",
  "trait.sunloving.description": "Grows faster in dry weather, but slower after rain.",
  "trait.sunloving.details": "Has a {{dryDayBoostChance}}% chance to grow an extra day after days without rain, but skips growing after rainy days",
  "trait.sunloving.notes": "Only applies outdoors. Storms count as rain. The extra day only counts on nights the crop grows (when it's watered).",
  "trait.sheltered.name": "Sheltered",
  "trait.sheltered.description": "Grows faster indoors, but slower outdoors.",
  "trait.sheltered.details": "Has a {{indoorBoostChance}}% chance to grow an extra day each night indoors, but a {{outdoorSkipChance}}% chance to skip growing each night outdoors",
  "trait.sheltered.notes": "The extra day only counts on nights the crop grows (when it's watered).",
  "trait.nocturnal.name": "Nocturnal",
  "trait.nocturnal.description": "Better quality when harvested at night, but worse during the day.",
  "trait.nocturnal.details": "Harvests from 6 PM onward have a {{nightStepUpChance}}% chance to rise one quality step, while earlier harvests have a {{dayStepDownChance}}% chance to drop one",
  "trait.nocturnal.notes": "Quality never goes below normal or past the crop's own limits.",
  "trait.instructive.name": "Instructive",
  "trait.instructive.description": "Gives more farming experience when harvested.",
  "trait.instructive.details": "Gives {{experienceBonus}}% more farming experience when harvested",
  "trait.instructive.notes": "Always gives at least 1 extra experience. Junimo harvests give no experience.",
  "trait.spent.name": "Spent",
  "trait.spent.description": "Doesn't grow back after being harvested.",
  "trait.spent.details": "Removed after its first harvest instead of growing back",
  "trait.spent.notes": "Only appears on crops that regrow.",
  "trait.mulching.name": "Mulching",
  "trait.mulching.description": "Keeps weeds from growing around it.",
  "trait.mulching.details": "Clears weeds from the eight surrounding tiles each morning",
  "trait.mulching.notes": "Cleared weeds don't drop anything. Also clears weeds spread by nearby Invasive crops.",
  "trait.tender.name": "Tender",
  "trait.tender.description": "Can be flattened by storms.",
  "trait.tender.details": "Has a {{flattenChance}}% chance to die overnight after a stormy day",
  "trait.tender.notes": "Only applies outdoors. Rain without lightning doesn't count.",
  "trait.fragile.name": "Fragile",
  "trait.fragile.description": "Loses quality the longer it's left unharvested.",
  "trait.fragile.details": "Harvest quality drops one step for each full day it's left ready",
  "trait.fragile.notes": "Harvesting on the day it's ready loses nothing. Steps go iridium, gold, silver then normal. Quality never goes below normal.",
  "trait.charming.name": "Charming",
  "trait.charming.description": "Makes a better gift.",
  "trait.charming.details": "Gives {{friendshipBonus}}% more friendship when given as a gift",
  "trait.charming.notes": "Only applies to gifts the villager doesn't dislike or hate. Artisan goods made from it don't keep the bonus.",
  "trait.pungent.name": "Pungent",
  "trait.pungent.description": "Makes a worse gift.",
  "trait.pungent.details": "Gives {{friendshipPenalty}}% less friendship when given as a gift",
  "trait.pungent.notes": "Only applies to gifts the villager doesn't dislike or hate, so it never makes a bad gift worse. Artisan goods made from it don't keep the bonus.",
  "trait.seedy.name": "Seedy",
  "trait.seedy.description": "The Seed Maker gets more seeds from it.",
  "trait.seedy.details": "{{extraSeedChance}}% chance for the Seed Maker to make one extra seed",
  "trait.seedy.notes": "Only applies when the Seed Maker makes the crop's own seeds.",
  "trait.conductive.name": "Conductive",
  "trait.conductive.description": "Lightning makes it fully grown instead of killing it.",
  "trait.conductive.details": "Lightning makes it fully grown instead of killing it. Storms also have a {{strikeChance}}% chance every 10 minutes to strike it while it isn't ready yet",
  "trait.conductive.notes": "Only on the farm. Lightning rods don't impact the extra strikes.",
  "trait.dominant.name": "Dominant",
  "trait.dominant.description": "Its traits can pull further on nearby mutations.",
  "trait.dominant.details": "Its traits can pull up to {{bonusCapMultiplier}} times as far for which trait nearby crops of the same type mutate into",
  "trait.dominant.notes": "Covers all eight surrounding tiles. Doesn't change how likely they are to mutate. Each neighbor still pulls as hard as normal, so the higher limit matters most when the nearby crops hold higher tier traits.",
  "trait.latent.name": "Latent",
  "trait.latent.description": "Does nothing until spliced, then awakens into something better.",
  "trait.latent.details": "Does nothing on its own. When it comes out of the Seed Splicer, it turns into a random positive trait at tier I",
  "trait.latent.notes": "Picks from traits the crop can mutate into that it doesn't already have and wouldn't conflict with. If none fit, it stays Latent. Using the Seed Maker keeps it Latent.",
  "trait.gilded.name": "Gilded",
  "trait.gilded.description": "Sometimes turns its harvest into coins worth double.",
  "trait.gilded.details": "Has a {{gildedChance}}% chance to turn the main harvest into coins worth {{valueMultiplier}}x its sale price",
  "trait.gilded.notes": "Extra produce (from crops like blueberries or traits like Prolific) are never turned into coins. Junimo harvests are never turned into coins and produce converted to coins don't count as shipped. A crop that also has Windfall rolls Windfall first, then Gilded if that fails.",
  "trait.waterside.name": "Waterside",
  "trait.waterside.description": "Grows faster near water, but slower away from it.",
  "trait.waterside.details": "Has a {{nearWaterBoostChance}}% chance to grow an extra day each night near water, but a {{awayFromWaterSkipChance}}% chance to skip growing each night away from it",
  "trait.waterside.notes": "Only applies outdoors. Near water means within {{waterRange}} tiles of any water tile. Doesn't appear on paddy crops like rice. The extra day only counts on nights the crop grows (when it's watered).",
  "trait.dryland.name": "Dryland",
  "trait.dryland.description": "Grows faster away from water, but slower near it.",
  "trait.dryland.details": "Has a {{awayFromWaterBoostChance}}% chance to grow an extra day each night away from water, but a {{nearWaterSkipChance}}% chance to skip growing each night near it",
  "trait.dryland.notes": "Only applies outdoors. Requires a water tile within {{waterRange}} tiles. The extra day only counts on nights the crop grows (when it's watered).",
  "trait.paddy.name": "Paddy",
  "trait.paddy.description": "Thrives near water like rice, without needing to be watered.",
  "trait.paddy.details": "Near water, never needs watering and has a {{nearWaterBoostChance}}% chance to grow an extra day each night",
  "trait.paddy.notes": "Only applies outdoors. Requires a water tile within {{waterRange}} tiles. Its soil is watered each morning while near water. It grows normally when not near a water tile.",
  "trait.solitary.name": "Solitary",
  "trait.solitary.description": "Grows faster with few crops around it, but slower when crowded.",
  "trait.solitary.details": "Has a {{aloneBoostChance}}% chance to grow an extra day each night with {{maxAloneNeighbors}} or fewer crops around it, but a {{crowdedSkipChance}}% chance to skip growing each night with {{minCrowdedNeighbors}} or more",
  "trait.solitary.notes": "Covers all eight surrounding tiles, counting crops of any type. With {{normalMin}} to {{normalMax}} crops around it, it grows normally. The extra day only counts on nights the crop grows (when it's watered).",
  "trait.companion.name": "Companion",
  "trait.companion.description": "Grows faster next to different crops.",
  "trait.companion.details": "Has a {{chancePerType}}% chance to grow an extra day each night for every other crop type around it (up to {{maxChance}}%)",
  "trait.companion.notes": "Covers all eight surrounding tiles. Each different crop type counts once, up to {{maxTypes}} types. The extra day only counts on nights the crop grows (when it's watered).",
  "trait.selfseeding.name": "Self-Seeding",
  "trait.selfseeding.description": "Sometimes plants a copy of itself in nearby tilled soil.",
  "trait.selfseeding.details": "Has a {{spreadChance}}% chance each night it's ready to harvest to plant a seedling in empty tilled soil around it",
  "trait.selfseeding.notes": "Spreads at most once each time it's ready to harvest and only while in season. The seedling carries the same traits and skips its first mutation roll. Crops with Seedless never spread.",
  "trait.slimy.name": "Slimy",
  "trait.slimy.description": "Slimes sometimes crawl out of it once it's fully grown.",
  "trait.slimy.details.tier_1": "Has a {{spawnChance}}% chance each morning to spawn a Green Slime",
  "trait.slimy.details.tier_2": "Has a {{spawnChance}}% chance each morning to spawn a Frost Jelly",
  "trait.slimy.details.tier_3": "Has a {{spawnChance}}% chance each morning to spawn a Red Sludge",
  "trait.slimy.notes": "{{monsterNotes}} The slime takes on the crop's color when it has one.",
  "trait.roosting.name": "Roosting",
  "trait.roosting.description": "Bats sometimes roost in it once it's fully grown.",
  "trait.roosting.details.tier_1": "Has a {{spawnChance}}% chance each morning to spawn a Bat",
  "trait.roosting.details.tier_2": "Has a {{spawnChance}}% chance each morning to spawn a Frost Bat",
  "trait.roosting.details.tier_3": "Has a {{spawnChance}}% chance each morning to spawn a Lava Bat",
  "trait.copperroots.name": "Copper Roots",
  "trait.copperroots.description": "Drops copper ore when harvested.",
  "trait.ironroots.name": "Iron Roots",
  "trait.ironroots.description": "Drops iron ore when harvested.",
  "trait.goldroots.name": "Gold Roots",
  "trait.goldroots.description": "Drops gold ore when harvested.",
  "trait.iridiumroots.name": "Iridium Roots",
  "trait.iridiumroots.description": "Drops iridium ore when harvested.",
  "trait.geoderoots.name": "Geode Roots",
  "trait.geoderoots.description": "Drops a geode when harvested.",
  "trait.geoderoots.details.tier_1": "Drops a Geode when harvested",
  "trait.geoderoots.details.tier_2": "Drops a Frozen Geode when harvested",
  "trait.omniroots.name": "Omni Roots",
  "trait.omniroots.description": "Drops an Omni Geode when harvested.",
  "trait.omniroots.details": "Drops an Omni Geode when harvested",
  "trait.composting.name": "Composting",
  "trait.composting.description": "Leaves fertilizer in its soil once it's gone.",
  "trait.composting.details": "Leaves {{fertilizer}} in its soil once it's harvested for the last time",
  "trait.composting.notes": "Only upgrades soil with no fertilizer or a weaker quality fertilizer. Other fertilizers like Speed-Gro are left alone. A crop that grows back leaves fertilizer after its final harvest.",
  "trait.contagious.name": "Contagious",
  "trait.contagious.description": "Passes one of its traits to a neighbor of the same type.",
  "trait.contagious.details": "Once ready to harvest, copies one of its traits (at tier I) onto an adjacent crop of the same type",
  "trait.contagious.notes": "Covers all eight surrounding tiles. Passes on one trait per planting, waiting until a neighbor has room. Never passes on itself or combination traits. A growing neighbor shows the new trait once it's fully grown, like a mutation.",
  "trait.wild.name": "Wild",
  "trait.wild.description": "Chance to find forage with the harvest.",
  "trait.wild.details": "{{forageChance}}% chance to find a piece of seasonal forage when harvested",
  "trait.wild.notes": "The forage matches the season where the crop grows. It's dropped on top of the normal harvest. {{paceNote}}",
  "trait.refreshing.name": "Refreshing",
  "trait.refreshing.description": "Restores a little energy when harvested.",
  "trait.refreshing.details": "Restores {{energy}} energy each time it's harvested",
  "trait.refreshing.notes": "Restores up to {{maxStaminaShare}}% of your maximum energy. Junimo harvests don't restore anything.",
  "trait.exhausting.name": "Exhausting",
  "trait.exhausting.description": "Costs extra energy to harvest.",
  "trait.exhausting.details": "Costs {{energy}} energy each time it's harvested",
  "trait.exhausting.notes": "Never reduces your energy below zero. Junimo harvests cost nothing.",
  "trait.hollow.name": "Hollow",
  "trait.hollow.description": "Sometimes crumbles into fiber when harvested.",
  "trait.hollow.details": "{{crumbleChance}}% chance for the main harvest to crumble into Fiber",
  "trait.hollow.notes": "Extra produce (from crops like blueberries or traits like Prolific) never crumble. Junimo harvests never crumble.",
  "trait.fickle.name": "Fickle",
  "trait.fickle.description": "Its quality follows your luck for the day.",
  "trait.fickle.details": "Harvests rise one quality step on lucky days and drop one on unlucky days",
  "trait.fickle.notes": "Uses the harvesting player's luck for the day. A neutral day leaves the quality alone. Quality never goes below normal or past the crop's own limits.",
  "trait.windfall.name": "Windfall",
  "trait.windfall.description": "Luckier days turn more of its harvest into coins.",
  "trait.windfall.details": "Has a {{minChance}}% to {{maxChance}}% chance to turn the main harvest into coins worth {{valueMultiplier}}x its sale price, higher on luckier days",
  "trait.windfall.notes": "A neutral luck day gives {{baseChance}}%, above Gilded's usual {{gildedChance}}%. A crop that also has Gilded rolls Windfall first, then Gilded if that fails. Extra produce is never turned into coins and produce turned into coins don't count as shipped. Junimo harvests are never turned into coins.",
  "trait.depleting.name": "Depleting",
  "trait.depleting.description": "Strips the fertilizer from its soil once it's gone.",
  "trait.depleting.details": "Strips the fertilizer from its soil once it's harvested for the last time",
  "trait.depleting.notes": "Removes every kind of fertilizer after harvesting. A crop that grows back keeps it until its final harvest.",
  "trait.trailing.name": "Trailing",
  "trait.trailing.description": "Can be walked through despite its trellis.",
  "trait.trailing.details": "Can be walked through, even though it grows on a trellis",
  "trait.trailing.notes": "Only appears on trellis crops like hops, grapes and green beans. Takes effect once the trait shows on the crop.",
  "trait.climbing.name": "Climbing",
  "trait.climbing.description": "Blocks the way like a trellis crop.",
  "trait.climbing.details": "Blocks movement like a trellis crop once it's past its first growth stage",
  "trait.climbing.notes": "Takes effect once the trait shows on the crop, so a hidden mutation only blocks the way once it's fully grown. Junimos can still get through.",
  "trait.ripe.name": "Ripe",
  "trait.ripe.description": "Machines finish sooner with it.",
  "trait.ripe.details": "Machines finish {{timeReduction}}% sooner when it's put in",
  "trait.ripe.notes": "Rounded up to the next 10 minutes. Casks aren't affected.",
  "trait.stubborn.name": "Stubborn",
  "trait.stubborn.description": "Machines take longer with it.",
  "trait.stubborn.details": "Machines take {{timeIncrease}}% longer when it's put in",
  "trait.stubborn.notes": "Rounded up to the next 10 minutes. Casks aren't affected.",
  "trait.recessive.name": "Recessive",
  "trait.recessive.description": "Its traits pass on less often when crossbred.",
  "trait.recessive.details": "Its own traits are {{inheritReduction}}% less likely to carry over when crossbred",
  "trait.recessive.notes": "Traits both parents share always carry over as normal. Only this parent's own traits are affected, Recessive included.",
  "trait.barren.name": "Barren",
  "trait.barren.description": "The Seed Maker gets fewer seeds from it.",
  "trait.barren.details": "{{fewerSeedChance}}% chance for the Seed Maker to make one fewer seed",
  "trait.barren.notes": "The Seed Maker always makes at least one seed. Only applies when it makes the crop's own seeds.",
  "trait.fading.name": "Fading",
  "trait.fading.description": "Seeds made from it can lose some of their traits.",
  "trait.fading.details": "{{fadeChance}}% chance that seeds made from it lose one tier of a random trait",
  "trait.fading.notes": "Only applies to the Seed Maker. A trait at tier I fades away entirely. Fading applies to itself as well.",
  "trait.mimic.name": "Mimic",
  "trait.mimic.description": "Copies a trait from a different crop nearby.",
  "trait.mimic.details": "Once ready to harvest, copies one trait (at tier I) from an adjacent crop of a different type",
  "trait.mimic.notes": "Covers all eight surrounding tiles. Copies one trait per planting, waiting until a neighbor has one it can take. Never copies itself or combination traits. Only copies traits its own crop could roll.",
  "trait.sour.name": "Sour",
  "trait.sour.description": "Slows you down for a while when eaten.",
  "trait.sour.details": "Eating it gives {{speedPenalty}} Speed for {{minutes}} minutes",
  "trait.sour.notes": "Eating more refreshes the slowdown instead of stacking it. Only appears on crops with edible produce.",
  "trait.mellow.name": "Mellow",
  "trait.mellow.description": "Gets better the longer it's left ready.",
  "trait.mellow.details.tier_1": "Harvest quality rises one step once it's left ready for {{days}} full days",
  "trait.mellow.details": "Harvest quality rises one step for every {{days}} full days it's left ready (up to {{steps}} steps)",
  "trait.mellow.notes": "Steps go normal, silver, gold then iridium. Quality never goes past the crop's own limits.",
  "trait.seasoned.name": "Seasoned",
  "trait.seasoned.description": "Better quality when harvested late in the season.",
  "trait.seasoned.details": "Harvests in the last week of the season have a {{stepUpChance}}% chance to rise one quality step",
  "trait.seasoned.notes": "The last week runs from day {{lastWeekStartDay}} to the end of the month, wherever the crop grows. Quality never goes past the crop's own limits.",
  "trait.dewy.name": "Dewy",
  "trait.dewy.description": "Waters the soil around it each morning.",
  "trait.dewy.details.tier_1": "Waters the soil on its four sides each morning",
  "trait.dewy.details.tier_2": "Waters all eight soil tiles around it each morning",
  "trait.dewy.notes": "Doesn't water its own soil, other Dewy crops or garden pots.",
  "trait.prickly.name": "Prickly",
  "trait.prickly.description": "Hurts a little to pick.",
  "trait.prickly.details": "Picking it costs {{damage}} health",
  "trait.prickly.notes": "Never takes you below 1 health. Junimos don't mind the thorns.",
  "trait.stunted.name": "Stunted",
  "trait.stunted.description": "Can never become a giant crop.",
  "trait.stunted.details": "Can never become a giant crop",
  "trait.stunted.notes": "One Stunted crop anywhere in the grid is enough to stop the whole giant crop. Only appears on crops with a giant form.",
  "trait.lucky.name": "Lucky",
  "trait.lucky.description": "Eating it brings a little luck.",
  "trait.lucky.details": "Eating it gives +{{skillBonus}} Luck for {{hours}} hours",
  "trait.lucky.notes": "Eating more refreshes the buff instead of stacking it. Only appears on crops with edible produce.",
  "trait.briny.name": "Briny",
  "trait.briny.description": "Eating it makes you better at fishing for a while.",
  "trait.briny.details": "Eating it gives +{{skillBonus}} Fishing for {{hours}} hours",
  "trait.briny.notes": "Eating more refreshes the buff instead of stacking it. Only appears on crops with edible produce.",
  "trait.earthy.name": "Earthy",
  "trait.earthy.description": "Eating it makes you better at mining for a while.",
  "trait.earthy.details": "Eating it gives +{{skillBonus}} Mining for {{hours}} hours",
  "trait.earthy.notes": "Eating more refreshes the buff instead of stacking it. Only appears on crops with edible produce.",
  "trait.fodder.name": "Fodder",
  "trait.fodder.description": "Chance to find hay with the harvest.",
  "trait.fodder.details": "{{hayChance}}% chance to find Hay when harvested",
  "trait.fodder.notes": "Dropped on top of the normal harvest. Junimos carry it to their hut. {{paceNote}}",
  "trait.gelatinous.name": "Gelatinous",
  "trait.gelatinous.description": "Drops slime instead of spawning slimes.",
  "trait.gelatinous.details": "Has a {{dropChance}}% chance each morning to drop a Slime once fully grown",
  "trait.gelatinous.notes": "The thorns catch what would have spawned, so nothing hostile appears.",
  "trait.nesting.name": "Nesting",
  "trait.nesting.description": "Drops bat wings instead of spawning bats.",
  "trait.nesting.details": "Has a {{dropChance}}% chance each morning to drop a Bat Wing once fully grown",
  "trait.nesting.notes": "The thorns catch what would have spawned, so nothing hostile appears.",
  "trait.tangy.name": "Tangy",
  "trait.tangy.description": "Sells for more and gives a burst of speed when eaten.",
  "trait.tangy.details": "Sells for {{priceBonus}}% more, plus +{{speedBonus}} Speed for {{hours}} hour when eaten",
  "trait.tangy.notes": "Its price bonus carries into artisan goods made from it, though only the produce itself gives the speed boost. Eating more refreshes the buff instead of stacking it.",
  "trait.amphibious.name": "Amphibious",
  "trait.amphibious.description": "Grows faster outdoors, near water or not.",
  "trait.amphibious.details": "Has a {{boostChance}}% chance to grow an extra day each night outdoors, near water or not",
  "trait.amphibious.notes": "Only applies outdoors. The extra day only counts on nights the crop grows (when it's watered).",
  "trait.secondwind.name": "Second Wind",
  "trait.secondwind.description": "Costs energy to pick, but restores a lot when you're tired.",
  "trait.secondwind.details": "Costs {{energyCost}} energy to harvest, but restores {{energyRestored}} when you're below {{lowEnergyShare}}% energy",
  "trait.secondwind.notes": "Never takes your energy below zero or past your maximum. Junimo harvests do nothing.",
  "trait.leeching.name": "Leeching",
  "trait.leeching.description": "Steals fertilizer from the soil around it.",
  "trait.leeching.details": "Each night, takes the strongest quality fertilizer from the soil around it into its own",
  "trait.leeching.notes": "Only Basic, Quality and Deluxe Fertilizer are taken and only when they are better. The soil it takes from is left barren. Nothing is taken if the crop already has fertilizer.",
  "trait.enriching.name": "Enriching",
  "trait.enriching.description": "Leaves fertilizer in and around its soil once it's gone.",
  "trait.enriching.details": "Leaves {{fertilizer}} in its soil and every empty soil around it once it's harvested for the last time",
  "trait.enriching.notes": "Only upgrades soil with no fertilizer or a weaker quality fertilizer. Soil with a crop growing in it is skipped.",
  "trait.tropical.name": "Tropical",
  "trait.tropical.description": "Grows faster in warm places and on dry days, with no penalty anywhere.",
  "trait.tropical.details": "Has a {{boostChance}}% chance to grow an extra day each night indoors or on Ginger Island, and after dry days everywhere else outdoors",
  "trait.tropical.notes": "Rain outside Ginger Island only cancels the boost for that night, without Sheltered's outdoor penalty or Sun Loving's rain penalty. Stormy days are counted as rain. The extra day only counts on nights the crop grows (when it's watered).",
  "trait.wellspring.name": "Wellspring",
  "trait.wellspring.description": "Waters itself and the soil around it each morning.",
  "trait.wellspring.details": "Waters its own soil and all eight soil tiles around it each morning",
  "trait.wellspring.notes": "Garden pots around it aren't watered, though its own pot is.",
  "trait.stormborn.name": "Stormborn",
  "trait.stormborn.description": "Thrives in storms instead of being flattened by them.",
  "trait.stormborn.details": "Grows an extra day after every stormy day and is never flattened by storms. Lightning makes it fully grown instead of killing it, like Conductive",
  "trait.stormborn.notes": "Only applies outdoors. Normal rainy days don't count and the extra day only counts on nights the crop grows (when it's watered). Storms on the farm can also strike it, like a Conductive crop.",
  "trait.eager.name": "Eager",
  "trait.eager.description": "Plants copies of itself that start halfway grown.",
  "trait.eager.details": "Has a {{spreadChance}}% chance each night it's ready to harvest to plant a seedling in empty tilled soil around it, starting halfway grown",
  "trait.eager.notes": "Spreads at most once each time it's ready to harvest and only while in season, even alongside Self-Seeding. The seedling carries the same traits and skips its first mutation roll. Crops with Seedless never spread.",
  "trait.dwarf.name": "Dwarf",
  "trait.dwarf.description": "Small but quick to grow, and still sells at full price.",
  "trait.dwarf.details": "{{sizeReduction}}% smaller with {{speedBonus}}% shorter growth time. Still sells at full price",
  "trait.dwarf.notes": "Can never become a giant crop. Growth time is rounded up to whole days, with each growth stage keeping at least one day.",
  "trait.enduring.name": "Enduring",
  "trait.enduring.description": "Outlasts its season and increases quality when harvested late.",
  "trait.enduring.details": "Keeps growing for {{outOfSeasonNights}} days after its season ends and increases quality when harvested outside the season.",
  "trait.enduring.notes": "Only matters outdoors, where crops die when their season ends. Hardy's extra days don't stack with these (uses whichever duration is longer). Quality never goes past the crop's own limits.",
  "trait.moonbloom.name": "Moonbloom",
  "trait.moonbloom.description": "Glows at night and is at its best when picked then.",
  "trait.moonbloom.details": "Glows softly at night. Harvests from 6 PM onward always rise one quality step",
  "trait.moonbloom.notes": "Unlike Nocturnal, daytime harvests lose nothing. Quality never goes past the crop's own limits.",
  "trait.clustered.name": "Clustered",
  "trait.clustered.description": "Smaller produce, but always one more.",
  "trait.clustered.details": "{{sizeReduction}}% smaller and sells for {{pricePenalty}}% less, but every harvest gives {{extraItems}} extra",
  "trait.clustered.notes": "The extra item keeps the same quality and traits.",
  "trait.untamed.name": "Untamed",
  "trait.untamed.description": "Brings forage and Foraging experience with its harvests.",
  "trait.untamed.details": "Harvests find a piece of seasonal forage, giving {{experience}} Foraging experience",
  "trait.untamed.notes": "Always finds forage on crops that take {{fullChanceDays}} or more days per harvest. {{paceNote}} The forage matches the season where the crop grows. Junimo harvests still find forage, but no experience is given.",
  "trait.cured.name": "Cured",
  "trait.cured.description": "Machines take longer with it, but its artisan goods sell for more.",
  "trait.cured.details": "Machines take {{timeIncrease}}% longer with it, but artisan goods made from it sell for {{artisanPriceBonus}}% more",
  "trait.cured.notes": "Machine times are rounded up to the next 10 minutes. Casks age by days, so their time isn't affected.",
  "trait.aged.name": "Aged",
  "trait.aged.description": "Casks age goods made from it faster.",
  "trait.aged.details": "Casks age artisan goods made from it {{agingBonus}}% faster",
  "trait.aged.notes": "Carries into the artisan goods made from it, so only those goods age faster. It doesn't change their price.",
  "trait.measured.name": "Measured",
  "trait.measured.description": "The Seed Maker always makes the same number of seeds from it.",
  "trait.measured.details": "The Seed Maker always makes exactly {{seedCount}} seeds from it",
  "trait.measured.notes": "Replaces the game's roll and any extra or missing seeds from traits like Seedy and Barren. Only applies when the Seed Maker makes the crop's own seeds.",
  "trait.pollinating.name": "Pollinating",
  "trait.pollinating.description": "Passes one of its traits to every neighbor of the same type.",
  "trait.pollinating.details": "Once ready to harvest, copies one of its traits (at tier I) onto every adjacent crop of the same type with room",
  "trait.pollinating.notes": "Covers all eight surrounding tiles. Each neighbor gets its own random pick. Spreads once per planting, even alongside Contagious. Never passes on itself or combination traits.",
  "trait.chimera.name": "Chimera",
  "trait.chimera.description": "Copies a trait from a different crop nearby, keeping its strength.",
  "trait.chimera.details": "Shares the Tinted trait's color. Once ready to harvest, copies one trait at its own tier from an adjacent crop of a different type",
  "trait.chimera.notes": "Covers all eight surrounding tiles. Copies once per planting, even alongside Mimic. Never copies combination traits. Only copies traits its own crop could roll.",
  "trait.beloved.name": "Beloved",
  "trait.beloved.description": "No villager can dislike it as a gift.",
  "trait.beloved.details": "Villagers never dislike or hate it as a gift. It also gives {{friendshipBonus}}% more friendship",
  "trait.beloved.notes": "A gift they'd dislike or hate is treated as neutral instead. Artisan goods made from it don't keep it.",
  "trait.acquiredtaste.name": "Acquired Taste",
  "trait.acquiredtaste.description": "Villagers react more strongly to it, good or bad.",
  "trait.acquiredtaste.details": "Every gift reaction is {{reactionMultiplier}}x as strong, good or bad",
  "trait.acquiredtaste.notes": "Loved, liked and neutral gifts give {{reactionMultiplier}}x the friendship, while disliked and hated gifts lose {{reactionMultiplier}}x as much. Artisan goods made from it don't keep the bonus."
}
